{
  "name": "desafio-teste-truco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Truco paulista — jogo e casos de teste de interface (Jest + Testing Library)",
  "scripts": {
    "start": "http-server . -p 8080 -c-1",
    "test": "jest",
    "verificar": "node scripts/verificar-testes.mjs",
    "verificar:completo": "node scripts/verificar-testes.mjs --completo",
    "mutacao": "stryker run"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@babel/core": "7.26.0",
    "@babel/preset-env": "7.26.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/jest-runner": "9.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.8",
    "babel-jest": "29.7.0",
    "http-server": "14.1.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/tests/**/*.spec.js"
    ],
    "transform": {
      "\\.js$": "babel-jest"
    }
  }
}
