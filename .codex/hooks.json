{
  "description": "TDD: roda os testes do Jest depois de cada edição em js/ ou tests/ e devolve o resultado ao agente.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/rodar-testes.mjs\"",
            "statusMessage": "Rodando os testes (TDD)",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
